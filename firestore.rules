rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function getRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return isSignedIn() && getRole() == 'ADMIN'; }
    function isManager() { return isSignedIn() && (getRole() == 'ADMIN' || getRole() == 'MANAGER'); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Settings Rules
    match /settings/config {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Products Rules
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isManager();
      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // Suppliers Rules
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // Purchases Rules
    match /purchases/{purchaseId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // Wholesalers Rules
    match /wholesalers/{wholesalerId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // Sales Rules
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // Employees Rules
    match /employees/{employeeId} {
      allow read: if isManager();
      allow write: if isAdmin();
    }

    // Assets Rules
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // Categories Rules
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }
  }
}
