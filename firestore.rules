rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isStaff() {
      return hasRole('STAFF') || isAdmin();
    }

    function isViewer() {
      return isSignedIn(); // Everyone authenticated can view
    }

    // Validation Blueprints
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'sku', 'quantity', 'price']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.sku is string && data.sku.size() > 0 && data.sku.size() <= 50 &&
             data.quantity is number &&
             data.price is number && data.price >= 0;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['productId', 'type', 'quantity', 'userId', 'timestamp']) &&
             data.productId is string &&
             data.type in ['IN', 'OUT', 'ADJUST'] &&
             data.quantity is number &&
             data.userId == request.auth.uid &&
             data.timestamp == request.time;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && 
                    request.resource.data.role == 'VIEWER'; // Default role is viewer for self-reg
      allow update: if isAdmin(); // Only admins can promote roles
    }

    // PRODUCTS
    match /products/{productId} {
      allow read: if isViewer();
      allow create: if isStaff() && isValidProduct(request.resource.data);
      allow update: if isStaff() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // TRANSACTIONS
    match /transactions/{transactionId} {
      allow read: if isViewer();
      allow create: if isStaff() && isValidTransaction(request.resource.data);
      allow update, delete: if false; // Transactions are immutable audit logs
    }

    // CATEGORIES
    match /categories/{categoryId} {
      allow read: if isViewer();
      allow write: if isStaff();
    }
  }
}
